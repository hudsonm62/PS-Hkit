# Auto detect text files and perform LF normalization
* text=auto

### OVERRIDES ###

# CRLF => LF
*.md             text  eol=lf
*.gitattributes  text  eol=lf
*.gitignore      text  eol=lf
*.svg            text  eol=lf
*.jsonc          text  eol=lf
*.json           text  eol=lf
*.yml            text  eol=lf
*.js             text  eol=lf
*.scss           text  eol=lf
*.prettierrc     text  eol=lf
*.prettierignore text  eol=lf
**/LICENSE       text  eol=lf
*.ps1            text  eol=lf
*.psm1           text  eol=lf
*.psd1           text  eol=lf
*.psc1           text  eol=lf
*.ps1xml         text  eol=lf
*.clixml         text  eol=lf
*.xml            text  eol=lf

# LF => CRLF
*.xaml   text  eol=crlf
*.url    text  eol=crlf
*.theme  text  eol=crlf
*.reg    text  eol=crlf  working-tree-encoding=UTF-16LE-BOM
